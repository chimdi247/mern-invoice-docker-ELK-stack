{
  "name": "mern-invoice",
  "version": "2.0.0",
  "description": "An invoicing web app built with the MERN Stack",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node --require ./dist/instrumentation.js dist/server.js",
    "dev": "cross-env OTEL_SDK_DISABLED=true tsx watch backend/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm --prefix tests run test:unit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/API-Imperfect/mern-invoice.git"
  },
  "keywords": [
    "Invoice",
    "MERN",
    "TypeScript",
    "OpenTelemetry"
  ],
  "author": "Alpha Ogilo",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/API-Imperfect/mern-invoice/issues"
  },
  "homepage": "https://github.com/API-Imperfect/mern-invoice#readme",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.62.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.203.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.203.0",
    "@opentelemetry/resources": "^2.0.1",
    "@opentelemetry/sdk-metrics": "^2.0.1",
    "@opentelemetry/sdk-node": "^0.203.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "mongoose": "^8.19.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.9",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "puppeteer-core": "^24.23.0",
    "validator": "^13.15.15",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^7.0.2",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/validator": "^13.15.3",
    "cross-env": "^10.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
