# =====================================================================================
# Copy to .env and fill in. docker compose reads it automatically.  NEVER commit .env
# =====================================================================================

# ---- MongoDB ----
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me-strong-password
DB_NAME=invoice

# ---- App ----
# Public URL of the app (links in e-mails + Google OAuth callback)
DOMAIN=http://localhost:1997
# generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

JWT_ACCESS_SECRET_KEY=asdfghjksdfghjklasdfghjklasdfghjkasdfghjkasdfghjasdfghjasdfgh
JWT_REFRESH_SECRET_KEY=asdfghjasdfghjsdfghjksdfghjkzxcvbnmasdfghjwertyusdfghdfghjk
# behind HTTPS set COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
LOG_LEVEL=http

# ---- E-mail: Gmail SMTP --------------------------------------------------------------
# 1) enable 2-Step Verification on the Google account
# 2) create an App Password: https://myaccount.google.com/apppasswords  (16 characters, no spaces)
# 3) SMTP_USER = the Gmail address, SMTP_PASS = the App Password
# The same account is used by Grafana to send alert e-mails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587            # 587 = STARTTLS, 465 = implicit TLS (then SMTP_SECURE=true)
SMTP_SECURE=true
SMTP_USER=chimdi247@gmail.com
SMTP_PASS=
# optional; Gmail rewrites the From address to the authenticated account unless an alias is configured
SENDER_EMAIL=chimdi247@gmail.com

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
ALERT_EMAIL_TO=shimdi247@gmail.com

# ---- Optional integrations ----
GOOGLE_CLIENT_ID=817832192373-jjq7g82jhipb09bqm00g850mlab84trt.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=auth/google/redirect
CLOUDINARY_CLOUD_NAME=dmyr68awx
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Object storage for Mimir (default: bundled MinIO). AWS S3: set endpoint/region/keys, S3_INSECURE=false ----
S3_ENDPOINT=minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_INSECURE=true
MIMIR_BLOCKS_BUCKET=mimir-blocks
MIMIR_RULER_BUCKET=mimir-ruler

# ---- Mongo Express (profile "tools") ----
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change-me

# ---- Rate limits (defaults shown) ----
RATE_LIMIT_API_MAX=100
RATE_LIMIT_LOGIN_MAX=20
